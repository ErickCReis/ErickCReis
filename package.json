{
  "name": "erickcreis",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:astro dev:api",
    "dev:astro": "bun --bun astro dev --host",
    "dev:api": "bun --watch server/index.ts",
    "tokens:sync": "bun scripts/token-usage-sync.ts",
    "db:generate": "drizzle-kit generate",
    "test": "bun test --parallel",
    "lint": "oxlint --fix --type-aware && oxfmt && tsgo --noEmit && astro check",
    "build": "bun --bun astro build && bun build ./server/index.ts --compile --outfile myserver",
    "start": "NODE_ENV=production bun server/index.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.7",
    "@astrojs/mdx": "7.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/solid-js": "7.0.2",
    "@elysia/cors": "^2.0.0-beta.1",
    "@elysia/cron": "^2.0.0-beta.1",
    "@elysia/eden": "^2.0.0-beta.5",
    "@solid-primitives/mouse": "^2.1.7",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solid-primitives/timer": "^1.4.4",
    "@solid-primitives/tween": "^1.4.1",
    "astro": "7.2.4",
    "astro-og-seo": "^0.2.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.3",
    "elysia": "^2.0.0-beta.6",
    "exact-mirror": "^1.2.4",
    "lucide-astro": "^0.556.0",
    "nanoid": "^6.0.1",
    "resend": "^6.21.0",
    "satteri": "0.10.5",
    "solid-js": "^1.9.15",
    "typebox": "^1.3.16",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "1.0.0-rc.3",
    "isomorphic-mermaid": "^0.1.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.2.2"
  },
  "packageManager": "bun@1.4.0"
}
