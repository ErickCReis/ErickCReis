---
import { Font } from "astro:assets";
import type { OgSeoJsonLd } from "astro-og-seo";
import OgSeo from "astro-og-seo/OgSeo.astro";
import { defaultLocale, locales, resolveLocale, t } from "virtual:translate";
import OgImageCard from "@web/components/og-image-card.astro";
import SitePresenceScript from "@web/components/site-presence-script.astro";
import { getLocalizedPath } from "@web/i18n";
import { AUTHOR_NAME, siteJsonLd } from "@web/lib/structured-data";

import "@web/styles/site.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  seo?: {
    type?: "website" | "article";
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    robots?: string;
    tags?: string[];
  };
  jsonLd?: OgSeoJsonLd[];
}

const { title, description, lang = "en-US", seo, jsonLd = [] } = Astro.props;
const locale = resolveLocale(lang);
const pathname = Astro.url.pathname.replace(/\/+$/g, "") || "/";
const pageType = seo?.type ?? "website";

function getContentPath(path: string) {
  if (locale === defaultLocale) return path === "/" ? "" : path.slice(1);

  const prefix = `/${locale}`;

  return path === prefix ? "" : path.slice(prefix.length + 1);
}

function getCanonicalUrl(path: string) {
  return new URL(path, Astro.site!);
}

const contentPath = getContentPath(pathname);
const alternates = [
  ...locales.map((alternateLocale) => ({
    href: getCanonicalUrl(getLocalizedPath(alternateLocale, contentPath)),
    hreflang: resolveLocale(alternateLocale),
  })),
  {
    href: getCanonicalUrl(getLocalizedPath(defaultLocale, contentPath)),
    hreflang: "x-default",
  },
];
const alternateLocales = locales
  .filter((alternateLocale) => resolveLocale(alternateLocale) !== locale)
  .map(resolveLocale);
const article =
  pageType === "article" && seo?.publishedTime
    ? {
        publishedTime: seo.publishedTime,
        modifiedTime: seo.modifiedTime,
        tags: seo.tags,
      }
    : undefined;
const siteDescription = t(
  locale,
  "TypeScript engineer building React and Next.js products, microfrontends, and realtime applications.",
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <OgSeo
      title={title}
      description={description}
      canonical={pathname}
      lang={locale}
      robots={seo?.robots}
      alternates={alternates}
      alternateLocales={alternateLocales}
      type={pageType}
      article={article}
      jsonLd={[...siteJsonLd(siteDescription), ...jsonLd]}
      generatedImageAlt={title}
    >
      <OgImageCard
        slot="image"
        title={title}
        description={description}
        locale={locale}
        type={pageType}
        publishedTime={seo?.publishedTime}
      />
    </OgSeo>
    <meta name="author" content={AUTHOR_NAME} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t(locale, "Blog | Erick Reis")}
      href={getCanonicalUrl(getLocalizedPath(locale, "rss.xml"))}
    />
    <meta name="theme-color" content="#070b13" />
    <Font
      cssVariable="--font-family-sans"
      preload={[{ subset: "core", style: "normal" }]}
    />
    <Font
      cssVariable="--font-family-serif"
      preload={[{ subset: "core", style: "normal" }]}
    />
    <Font cssVariable="--font-family-mono" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://stats.erickr.dev/s.js"
          data-website-id="d1dc6684-f6f2-496f-b251-886945dc0693"
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <SitePresenceScript />
    <div class="site-background" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style>
  .site-background {
    position: fixed;
    inset: -20svh 0;
    z-index: -1;
    pointer-events: none;
    background-color: hsl(var(--background));
    background-repeat: no-repeat;
    background-image:
      radial-gradient(circle at 12% 8%, rgb(72 99 145 / 30%), transparent 42%),
      radial-gradient(
        circle at 88% 92%,
        rgb(112 180 171 / 20%),
        transparent 46%
      ),
      linear-gradient(180deg, rgb(7 12 22 / 92%), rgb(7 11 19 / 98%));
  }
</style>
